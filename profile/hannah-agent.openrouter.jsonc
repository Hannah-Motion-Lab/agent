{
  // ─────────────────────────────────────────────────────────────────────────
  // Hannah profile — OpenRouter / GLM 5.3 Flash variant.
  //
  // Same posture as hannah-agent.jsonc, but the agent brain is `z-ai/glm-5.3-flash`
  // through OpenRouter: 1M context, tool calling, and cheap ($0.075/M in, $0.25/M
  // out — a typical task costs a fraction of a cent). It is what the free "Ox Alpha"
  // stealth preview turned out to be: the day it was revealed (2026-08-26) the
  // stealth id started returning 404, which is why this profile does not use it.
  // Strong enough for multi-step tool use, which the persona's local 7B is not.
  //
  //   1. export OPENROUTER_API_KEY=sk-or-...   (https://openrouter.ai/keys — add credits)
  //   2. scripts/install-profile.sh --openrouter
  //   3. hannah-agent serve --port 8006
  //
  // ── PRIVACY — read before enabling ───────────────────────────────────────
  // The provider is Z.ai (Zhipu), reached through OpenRouter. Everything a task
  // touches — file contents, command output, your prompt — leaves the machine
  // and reaches both. Check OpenRouter's and Z.ai's data policies for the current
  // retention terms; the `companion` preset and the sensitive-path denylist
  // (packages/agent/src/hannah/policy/paths.ts) limit WHAT a task can read, they
  // do not change WHERE it goes. For sensitive work use the Ollama profile.
  // The account needs credits: without them every task fails at the model.
  //
  // If the model is ever withdrawn, this profile is the only thing to change:
  // swap `model` for another OpenRouter id (or install hannah-agent.jsonc).
  // ─────────────────────────────────────────────────────────────────────────

  "model": "openrouter/z-ai/glm-5.3-flash",
  // Same model for the cheap slot: it is cheap enough, and a second provider
  // would be a second place the task text goes.
  "small_model": "openrouter/z-ai/glm-5.3-flash",
  "enabled_providers": ["openrouter"],

  // The provider comes from the public catalog (models.dev), which already
  // lists `stealth/ox-alpha`, reads the key from OPENROUTER_API_KEY, and uses
  // the official OpenRouter SDK — the engine's openrouter plugin adds the
  // X-Title attribution header on top. Nothing to declare here: the catalog
  // entry is the source of truth for baseURL, model limits and tool support.
  // (If the catalog ever drops the model, declare it under "provider" like the
  // Ollama profile does — see hannah-agent.local.jsonc.)

  "share": "disabled",
  "autoupdate": false,

  "server": {
    "hostname": "127.0.0.1",
    "port": 8006,
    "mdns": false,
    "cors": []
  },

  // Identical permission posture to the default profile. A cheap remote model
  // is a reason for more caution, not less: every approval is also a decision
  // about what leaves the machine.
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "pwd": "allow",
      "cat": "allow",
      "head": "allow",
      "tail": "allow",
      "wc": "allow",
      "file": "allow",
      "stat": "allow",
      "du": "allow",
      "df": "allow",
      "which": "allow",
      "echo": "allow",
      "date": "allow",
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git remote": "allow",
      "rm": "ask",
      "sudo": "ask",
      "chmod": "ask",
      "chown": "ask",
      "curl": "ask",
      "wget": "ask",
      "ssh": "ask",
      "scp": "ask",
      "dd": "ask",
      "mkfs": "ask"
    },
    "external_directory": "ask"
  },

  "tools": { "webfetch": false, "websearch": false },

  "subagent_depth": 1,
  "snapshot": true,
  "compaction": { "auto": true },
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  "formatter": false,
  "lsp": false,
  "logLevel": "INFO"
}
